+   unsigned                       m_collate_type;    // the form of the collation string
+   charT                          m_collate_delim;   // the collation group delimiter
+   std::locale m_locale{""};
+   // TODO: use a hash table when available!
+   std::map<charT, regex_constants::syntax_type> m_char_map;
