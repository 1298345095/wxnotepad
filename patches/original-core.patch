+template <>
+class cpp_regex_traits<wchar_t>
+{
+public:
+   typedef wchar_t                       charT;
+   typedef charT                         char_type;
+   typedef std::size_t                   size_type;
+   typedef std::basic_string<char_type>  string_type;
+   typedef std::locale                          locale_type;
