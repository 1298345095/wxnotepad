 static void
+button_data_cancel (ButtonData *button_data)
+{
+  GCancellable *cancellable = button_data->cancellable;
+
+  if (cancellable == NULL)
+    return;
+
+  button_data->cancellable = NULL;
+
+  /* Dispose/finalize cancels requests before the path bar can go away.
+   * An already-cancelled request must not access its former path bar.
+   */
+  if (!g_cancellable_is_cancelled (cancellable))
+    cancel_cancellable (button_data->path_bar, cancellable);
+
+  g_object_unref (cancellable);
+}
