 #if defined(wxHAVE_WAYLAND_SESSION_MANAGEMENT) || \
@@ -47,6 +55,11 @@
 #include "wx/protocols/xdg-toplevel-drag-v1-client-protocol.c"
 #endif // wxHAVE_WAYLAND_TOPLEVEL_DRAG
 
+#undef xdg_popup_interface
+#undef xdg_positioner_interface
+#undef xdg_surface_interface
+#undef xdg_toplevel_interface
+
 wxGCC_WARNING_RESTORE(attributes)
 
 constexpr const char* TRACE_WAYLAND = "wayland";

